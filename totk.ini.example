# totk.ini: settings for totk.exe. Copy this file to totk.ini next to totk.exe and remove the '#' of a line to change it.
# Each line shows the default; on a Steam Deck the device profile ([display]) changes a few of them. A TOTK_*
# environment variable of the same name (TOTK_FPS_LIMIT for fps_limit) overrides the file. Keys are case-insensitive;
# '#' and ';' start a comment; [sections] only group lines.

[frame rate]
# Frame rate limit: 30, 40, 45, 60, 90, 120, 144, any whole rate from 30 to 360, display (the refresh rate of the
# window's monitor) or unlimited (no wait; with vk_present = fifo the monitor still caps it). Above 60 and unlimited
# are experimental and need realtime = 1. Changes while the game runs take effect at once.
# fps_limit = 60
# Older key, read only while fps_limit is unset: fps60 = 0 means a limit of 30.
# fps60 = 1
# Real-time frame step: game speed follows the clock instead of the frame count.
# Bananza: experimental, defaults to 0. TotK: defaults to 1. Changing this needs a restart.
# realtime = 1
# Cloth simulation on the real-time clock. Needs realtime = 1.
# cloth_realtime = 1
# Fix for physics that bounce at high frame rates.
# highfps_fix = 1
# AMD Anti-Lag 2 (experimental, off by default): on an AMD GPU whose driver has VK_AMD_anti_lag, the driver starts each
# frame as late as it can, for less delay from input to the screen. The row appears in Display > Frame rate only where
# the device has it. On Linux, Mesa's RADV has it through the layer VK_LAYER_MESA_anti_lag, which the game loads when
# antilag = 1 at start (so on RADV, turning it on needs a restart), unless you set ENABLE_LAYER_MESA_ANTI_LAG or
# DISABLE_LAYER_MESA_ANTI_LAG yourself. Elsewhere changes while the game runs take effect at once.
# antilag = 0

[performance]
# The keys of this section and of [diagnostics] are for testing and troubleshooting, and take effect at the next start.
# The Advanced tab of the settings menu (F1) shows all of them except zstd_native and zstd_check.

# Scheduling.
# A thread waiting for a virtual core interrupts the owner when it runs game code: 1 = on, 2 = priority inheritance
# without the interrupt, 0 = off (the old scheduling).
# async_preempt = 1
# Replay NVN submissions on their own thread, at most one frame behind the game (1 = on). Adds up to a frame of latency.
# replay_async = 0
# 1 lifts the virtual core gate: guest threads run without the console's limit of one thread per core. For experiments
# only: the game keeps per-core data without locks and can crash.
# free_cores = 0
# Windows timer resolution of 1 ms for steadier frame pacing (0 = the Windows default).
# timer_1ms = 1

# Shaders and pipelines.
# Draws whose pipeline is still building: default waits on a reserved worker; draw is the previous scheduling.
# pipe_wait = default
# Which draws are dropped instead of waiting for their pipeline: strict (only draws into per-frame passes), any (also
# draws into passes whose target the previous frame rendered) or fullscreen (those and full-screen draws).
# pipe_skip = fullscreen
# Build shader stage libraries in the background ahead of time, and the threads for it (1 to 16; default: a quarter of
# the CPU threads).
# lib_prebuild = 1
# lib_prebuild_threads = 4
# Build known pipelines ahead of time.
# pipe_prebuild = 1
# Threads that translate known shaders at start (1 to 64; default: half the CPU threads, at most 16).
# prewarm_xlate = 8
# Vulkan graphics pipeline library, 0 or 1. Default: on, except on AMD's driver for RDNA 1 and 2 (RX 5000 and 6000).
# gpl = 1

# Textures and memory.
# ASTC texture decoding: native (the GPU's own ASTC support), gpu (a compute shader), cpu, or auto (native when the GPU
# has it, gpu otherwise).
# astc = auto
# Game memory shared with the GPU: auto (mirror on a discrete GPU, import on an integrated one), import (host memory
# imported into Vulkan), mirror (pools used as buffers get a copy in video memory) or verify (mirror plus a check of
# every copy; slow).
# memory = auto
# Linux: copy a shader's storage write back to the game's memory only when the game's code touches it (0 or 1;
# default 0).
# wb_lazy = 0
# A new texture created over a live texture's memory starts with that content instead of empty.
# tex_alias = 1
# Drop or release cached textures when VRAM usage rises above this percentage (0 to 100; 0 = off). Default: 90.
# tex_vram_pressure = 90
# Host zstd decoder in place of the game's (0 = the game's), and a check that decodes every call both ways and logs
# the differences (1 = on; slow).
# zstd_native = 1
# zstd_check = 0

# Render fixes.
# Wait for the game to finish rewriting level-of-detail data before the GPU reads it: stops objects flashing in the
# wrong place and a flat far field for a frame.
# lod_guard = 1
# Fill the driver-reserved constant bank c0 (storage sizes, dispatch size, point size, base instance) instead of zeros.
# fix_c0 = 1
# Bananza on NVIDIA: skip the light-quad draws that fault the GPU after the first guide movie (#9).
# fix_vs_fault = 1
# New GPU memory pools start zero-filled, as Switch memory does.
# fix_zero = 1
# Primitive restart on triangle-list draws, as the Switch does (needs primitiveTopologyListRestart). Without it the
# restart indices are fetched as vertices and draw long stretched triangles (Bananza's map).
# list_restart = 1
# Optimisations, 0 turns each off: skip bindings that did not change, remember shader lookups, reuse the previous
# draw's pipeline when its state repeats, remember texture descriptors between draws, update descriptors in bulk,
# skip push constants that did not change.
# bind_skip = 1
# shader_memo = 1
# pipe_memo = 1
# tex_memo = 1
# desc_template = 1
# push_skip = 1
# Submit GPU work in parts every N draws between passes so the GPU starts earlier (0 to 1000; 0 = off), each part at
# least split_us microseconds long (0 to 20000).
# split_draws = 64
# split_us = 1000

# Vulkan.
# Vulkan validation layer: checks every call and slows the game down a lot. Needs the layer installed (Vulkan SDK).
# vk_validation = 0
# A thread of its own makes the Vulkan calls of each frame, 0 or 1. Default: on.
# vk_recorder = 1
# Dynamic vertex input, 0 or 1. Default: on, except on Intel's older integrated GPU drivers (Vulkan 1.3.215 and older).
# vk_dyn_vertex = 1
# Dynamic alpha to coverage, 0 or 1. Default: on, except on AMD's driver for RDNA 2 and older (RX 400 to RX 6000),
# which applies alpha to coverage while the dynamic state says off and draws the characters black.
# vk_dyn_a2c = 1
# Pin the shader subgroup size to 32 when the GPU allows it.
# vk_subgroup_pin = 1

[display]
# Device profile: auto (the Steam Deck when this is one), desktop or deck. On a Steam Deck the keys this file does not
# set default to fullscreen = 1, window_size = 1280x800, output_res = 1280x800, render_scale = game, vk_present = fifo
# and fps_limit = 40 (starting points, not measured yet). Read at start.
# device_profile = auto
# Presentation mode: mailbox (default when the driver offers it, vsync otherwise), fifo (vsync) or immediate.
# vk_present = mailbox
# Window client area in screen pixels (640x360 to 7680x4320), and borderless fullscreen. Windows display scaling does
# not apply: at 150% scale, 1920x1080 covers the area 1280x720 covers at 100%. F11 switches fullscreen and saves it
# here. Changes while the game runs take effect at once.
# window_size = 1920x1080
# windowed, borderless (over the screen) or fullscreen (the display's own mode with SDL windows; on Windows, borderless
# kept above every other window). Wins over fullscreen below when both are set.
# window_mode = windowed
# fullscreen = 0
# 1, the default: the game keeps running while you are in another window; the keyboard stays quiet until the window is
# in front again. 0: it pauses when its window loses focus, as it does on the Switch when Home is pressed; a load
# interrupted that way can stop for good. Read at each focus change.
# assume_focus = 1
# 0 hides the console window the game opens next to its own, for frontends such as Playnite; the log still goes to
# logs/dkb.log. A command prompt the game was started from stays as it is. Changing this needs a restart.
# console = 1
# Performance overlay in the top right corner: off, fps, full (frame rate, mean and longest frame time), breakdown
# (full, with each frame's parts stacked in the graph: the game's own work, the GPU frame prep, the waits by cause, the
# frame limit) or counter (the frame rate as a large outlined number with no background). F10 cycles the modes in
# game, as do both stick clicks (L3 + R3) on a controller.
# perf_overlay = off
# Which GPU to use: its index in the log, or part of its name. Default: the first discrete GPU with Vulkan 1.3.
# gpu_index = 0
# gpu_name = NVIDIA
# Linux: a Vulkan driver of your own for this game only, such as a Mesa build outside the system's folders: the path of
# its ICD .json file ("~" expands), for example ~/.local/mesa/share/vulkan/icd.d/radeon_icd.x86_64.json. Empty uses the
# system's drivers. A VK_DRIVER_FILES or VK_ICD_FILENAMES already set in the environment wins. Read at start.
# vulkan_driver =
# Game resolution: the size the game draws its picture and interface in (1280x720 to 7680x4320). Above 1920x1080 the
# game's texture heap and memory pool grow with it. Another shape than 16:9, such as 3440x1440 on a 21:9 monitor or
# the Steam Deck's 1280x800 (16:10), gives the camera's view that shape and lays the HUD out for it. The installer
# prepares the UI layout for ten sizes: 2560x1080, 3440x1440, 3840x1600, 5120x2160 (21:9), 3840x1080, 5120x1440 (32:9),
# 1280x800, 1680x1050, 1920x1200 and 2560x1600 (16:10). Any other size
# gets the camera's view but a 16:9 HUD, stretched over the picture, unless you build its layout with
# tools/make_romfs_patches.py --aspect WxH. Read at start.
# output_res = 1920x1080
# 3D render scale: the scene's size relative to the game resolution, game (5/6, the game's own 1600x900 at 1080p) or
# a percentage (25 to 400, at most 4096 pixels a side); above 100 supersamples the scene (anti-aliasing). Read at start.
# TotK only: Bananza draws at the game's own size, and the HUD and dkb.log report its upscaler's input and output sizes.
# render_scale = game
# What scales the 3D picture up (the menu's Upscaling method row): fsr and bilinear are both the game's own upscaler;
# dlss, fsr3 and fsr4 below replace it. bilinear is also the older spelling of window_filter = linear, honoured only
# while window_filter is not set. Changes while the game runs take effect at once.
# upscaler = dlss (experimental, NVIDIA RTX only, read at start) also replaces the game's own upscaler with NVIDIA DLSS
# and leaves the window to window_filter; it needs nvngx_dlss.dll next to dkb.exe (docs/dkb-dlss.md) and falls back to the
# game's upscaler, with a "dlss:" line in the log, when anything is missing.
# upscaler = fsr3 (experimental, any GPU with push descriptors and extended storage formats, read each frame) does the same
# with AMD FSR 3.1's temporal upscaler, from the same jitter, scene depth and camera motion DLSS gets; frames without a scene
# at the input size go to the game's upscaler. The log has "fsr3:" lines (a summary every 1800 frames and at exit).
# upscaler = fsr4 (experimental) runs AMD FSR 4 from the same inputs, through AMD's own signed DLLs
# (amd_fidelityfx_loader_vk.dll and amd_fidelityfx_upscaler_vk.dll next to dkb.exe, docs/dkb-dlss.md) or, on Linux, a Vulkan
# FSR 4 library named amd_fidelityfx_upscaler_vk.so (set upscaler = fsr4 before the start there); without them, or on a GPU
# with no FSR 4 (NVIDIA), the log has one "fsr4:" line saying why and FSR 3.1 runs instead.
# upscaler = fsr
# The folder AMD's FSR 4 library is looked for in first (upscaler = fsr4); the game's program's folder comes after it.
# fsr_dir =
# How the finished picture is scaled to the window, with any upscaler (the menu's Window scaling filter row): fsr1 (the
# default: AMD FSR 1 where the window is larger than the game's picture, as before, and nothing else), or linear,
# catmull_rom or lanczos, which also sharpen with Sharpness at any window size and scale the game's own HDR picture
# (hdr_native) on its PQ code values. A window smaller than the picture is filtered over the pixels each window pixel
# covers. Takes effect at once.
# window_filter = fsr1
# Bananza only: auto keeps the game's dynamic 3D resolution (usually two thirds of output_res on each side), full draws
# the 3D scene at output_res (sharper, more GPU cost; no upscaler then, except that on update 3.2.0 upscaler = fsr3,
# fsr4 or dlss runs at that size as native anti-aliasing, docs/dkb-testing.md), a ratio from 1.0 to 3.0 draws it at
# output_res divided by that ratio and upscales it to output_res (1.5 with upscaler = dlss: DLSS Quality at output_res).
# Read at start.
# scene_res = auto
# Sharpening of the finished picture, 0 (off) to 100, at any window size, the game resolution's size included, and on the
# game's own HDR picture too. Takes effect at once.
# sharpness = 80
# SMAA 1x anti-aliasing of the final picture: off (the default), low, medium or high. It runs after the picture is scaled to
# the window (window_filter) and before the menu is drawn, so the game's HUD is smoothed as well. Changes while the game
# runs take effect at once.
# smaa = off
# CRT filter on the finished picture, the game's HUD included, after scaling and SMAA and before the menu: off (the
# default), lottes_grille (Timothy Lottes' aperture grille), lottes_tv (the same, curved, with a shadow mask), hyllian
# (Hyllian Fast) or zfast (zfast CRT). crt_lines is its virtual screen's lines: 240 (the default), 480 or 720, at most
# half the window's height. SDR only: the game's own HDR picture (hdr_native) bypasses it, and the log says so once.
# Changes take effect at once.
# crt_filter = off
# crt_lines = 240
# Frame generation (experimental, Donkey Kong Bananza only): off (the default), auto, or 2x to 8x. Frames are made between
# each two of the game's, from their motion. At 2x one is made and shown first, then the game's own frame half a frame
# later, so a game at 30 fps is shown at 60. auto gives each refresh of the display between two game frames a frame, up
# to 4 a game frame (the refresh over 30 fps), shown one game frame later. 3x to 8x make that many frames for each of the
# game's, and no more than the display can show: a game at 60 fps on a 165 Hz display gets 2 whatever the multiplier. The
# menu overlay is drawn on every shown frame and is never interpolated. No frame is made after a gap of over 100 ms,
# when the picture's size changes, when at 2x the display's refresh is below the doubled rate, or unless vk_present is
# mailbox or immediate. The game's own HDR picture (hdr_native) gets made frames too. Changes while the game runs take
# effect at once.
# The Display tab of the settings menu (F1) has this as Frame generation.
# frame_gen = off
# What makes the frames of frame_gen = 2x (experimental): builtin, the default, from the picture alone; fsr3, AMD FSR 3.1's
# frame interpolation, which also uses the scene's depth and motion. fsr3 runs only while a temporal upscaler (upscaler =
# dlss, fsr3 or fsr4) draws the 3D below the output size, at 2x, with the display's refresh over twice the game's rate; a
# frame it cannot make (no depth or motion, a camera cut, the first frame after a gap) gets the built-in one, and the other
# frame_gen values always use the built-in one, as does the game's own HDR picture (hdr_native), which AMD's passes do
# not take. AMD's passes are given the picture copied before the game draws its HUD, so the HUD is not moved with the
# scene. Changes while the game runs take effect at once.
# The menu's Frame generation made by row shows while frame_gen is 2x.
# frame_gen_by = builtin
# Picture shape when the window's shape differs from the game resolution's (a 16:9 picture in a 21:9 fullscreen
# window): fit, the default, keeps the shape, with black bars at the sides or above and below, so a 16:9 game in a wider
# window is no longer stretched as it used to be; stretch fills the window. Changes while the game runs take effect at
# once.
# aspect = fit
# Field of view, in percent of the game's own: 70 to 140, 100 (the default) leaves the camera as it is. Higher shows
# more of the world around Link. Game version 1.4.3 only. Changes while the game runs take effect at once.
# fov = 100
# Colour adjustment of the picture, HUD included, before it is scaled to the window: brightness (-30 to 30, added in %),
# contrast and saturation (70 to 150 and 50 to 200 %), gamma (0.8 to 1.2, below 1 brightens dark tones). At 0, 100,
# 100 and 1 nothing runs. color_preset is the menu's profile (default, vivid, clarity, custom), which sets the four.
# Changes while the game runs take effect at once.
# color_preset = default
# color_brightness = 0
# color_contrast = 100
# color_saturation = 100
# color_gamma = 1

# HDR output (experimental): hdr = 1 sends the picture as HDR10 (needs HDR on in Windows, "Use HDR", or a Wayland
# compositor with colour management; without it the picture stays SDR). The game's SDR picture is lifted in a last
# pass: highlights above a knee are stretched towards hdr_peak_nits (your display's peak) with their hue kept;
# hdr_game_nits is the picture's white (paper white, 203 is the HDR reference; the game's HUD follows it) and
# hdr_ui_nits the in-game menu's white.
# hdr is read at start, the nits at once.
# hdr = 0
# hdr_peak_nits = 1000
# hdr_game_nits = 203
# hdr_ui_nits = 203
# Bananza 3.2.0 only (untested on 1.0.0, where it stays off), read at start: with hdr = 1,
# hdr_native = 1 lets the game make its own HDR10 picture (the console's HDR mode) instead of lifting the SDR one, while
# the swapchain is HDR10; hdr_peak_nits and hdr_game_nits are what it is told the display has. The game caps its peak
# at 1400 nits, so a higher hdr_peak_nits changes nothing there; the display is told the game's peak. Its highlights
# reach that peak (the game's own curve stops at about 1.36 times hdr_game_nits). FSR, SMAA, the CRT filter and the colour
# adjustment are off with hdr_native.
# hdr_native = 0

[language]
# Language: a Windows locale such as de-DE, or a Switch code (en-US, ja, zh-Hant, ...). Default: the Windows locale.
# locale = en-US
# lang = en-US
# System mode reported to the game: docked or handheld.
# operation_mode = docked
# Language of the settings menu and the overlay: en or ru. Default: the Windows display language, English if it is
# neither.
# menu_lang = en

[audio]
# none mixes without opening an audio device.
# audio = default
# Audio the output queues before it starts, in ms (0 to 500).
# audio_prefill_ms = 20
# Volume in percent (0 to 100), on top of the game's own. Changes while the game runs take effect at once.
# volume = 100
# Speakers: auto (5.1 when the default output device has six or more channels, stereo otherwise), stereo or 5.1. The
# game is told the same channel count and mixes for it. Falls back to stereo if the device refuses 5.1. Takes effect
# at the next start.
# audio_channels = auto

[input]
# Choose the controller in F1 > Controls > Controller Device. The saved device key is opaque.
# Saved manual choices apply at startup, with first-available fallback. New connections take over automatically.
# Disconnecting the active controller falls back to another device. Automatic changes do not overwrite this preference.
# pad_device = auto
# Default: Plus + Minus opens settings. Opt in to a physical Start + Back fullscreen hold instead (0.5 s).
# Guide/Home and keyboard F1 still open settings in either mode.
# pad_fullscreen_hold = 0
# Gamepad motion controls (0 = off) and vibration (0 = off).
# motion = 1
# rumble = 1
# Rumble strength in percent (0 to 300; 0 = off) and the exponent on the amplitude (0.2 to 1.5; lower = weak pulses
# stronger, 1 = linear). rumble_triggers = 1 also drives the impulse triggers of an Xbox pad.
# rumble_strength = 130
# rumble_curve = 0.6
# rumble_triggers = 0
# Switch 2 controllers (Pro Controller 2, Joy-Con 2) over Bluetooth LE, with HD rumble: 1 on, 0 off, 2 on and logs
# every advertising Bluetooth device once (for a report when one is not found). Hold Sync on a controller with the game
# open to pair it with this PC; after that any button reconnects it. Do not pair it in the system's Bluetooth settings.
# Over USB they work through SDL without this. Takes effect at the next start. docs/controls.md, "Switch 2 controllers".
# switch2 = 0
# Which gamepad button is Switch A: nintendo (by position: east A, south B, west Y, north X), xbox (south A, east B,
# west X, north Y, as an Xbox pad labels them; cross A on a PlayStation pad) or auto (nintendo for a pad with Nintendo
# labels, xbox for the others). xbox_prompts: the buttons as nintendo, and the game's prompts swapped to the Xbox
# labels (A with B, X with Y; it loads romfs-patches-xbox, docs/controls.md, "Xbox button prompts"). The bind_ lines
# below apply on top. Changes while the game runs take effect at once; the xbox_prompts prompts at the next start.
# pad_layout = auto
# Bananza: the button prompts for a PlayStation pad (cross, circle, square, triangle, L1 to R2, Options, Create;
# docs/controls.md, "PlayStation button prompts"). auto takes them when a DualShock or DualSense pad is connected at
# start, playstation always, switch never. The game reads its fonts at boot, so a change takes effect at the next start.
# pad_prompts = auto
# Gamepad stick dead zone in percent of full deflection (0 to 50). Raise it for a stick that drifts: inside the circle
# the stick reads centred, and the rest of its travel is scaled to start there.
# stick_deadzone = 8
# Mouse camera sensitivity (0 to 10; 0 = no mouse camera and no cursor capture).
# mouse_sens = 1
# Write the input of this run to a file that replays as a script (docs/controls.md, "Scripted input"). Default: off.
# input_record = input.txt
# Remap buttons: the Controls tab of the settings menu (F1) writes these lines. One line per Switch button or stick
# direction: bind_<A B X Y L R ZL ZR PLUS MINUS LEFT UP RIGHT DOWN LCLICK RCLICK> or bind_<LSTICK RSTICK>_<LEFT UP RIGHT
# DOWN> = comma separated pad:<name> and key:<name> entries, key:default / pad:default for that part's defaults, or none.
# A line replaces that button's defaults (pad and keyboard); buttons without a line keep them. Stick directions take keys
# only. Invalid entries are logged and skipped. Changes while the game runs take effect at once.
#   pad names: south east west north l r zl zr start back lstick rstick dpad_left dpad_up dpad_right dpad_down
#   lpaddle1 rpaddle1 lpaddle2 rpaddle2 (the back buttons of an Xbox Elite, DualSense Edge or Steam Controller)
#   key names: a-z 0-9 f2-f7 f9 f12 num0-num9 space tab enter backspace lshift rshift lctrl rctrl lalt capslock insert
#   delete home end pageup pagedown up down left right num_add num_sub num_mul num_div num_decimal minus equals
#   lbracket rbracket semicolon apostrophe comma period slash backslash grave mouse_l mouse_r mouse_m mouse_x1 mouse_x2
# Defaults (pad_layout = nintendo): A = pad:east, key:E. B = pad:south, key:lshift. X = pad:north, key:space.
# Y = pad:west, key:mouse_l. A pad that reports A/B and X/Y swapped (some GuliKit models): set pad_layout = xbox, or
# swap them back here (keyboard keys stay):
# bind_A = pad:south, key:E
# bind_B = pad:east, key:lshift
# bind_X = pad:west, key:space
# bind_Y = pad:north, key:mouse_l

[files]
# Folder with RomFS mod files that replace or add game files (docs/dkb-testing.md, "Mods"). Default: the mods folder next
# to dkb.exe; 0 turns mods off.
# romfs_mods =

[diagnostics]
# Experimental Switch 2 reads of up to 4 KiB without waiting; requires replay_async = 1. Opt-in only: its background
# write-back can overwrite mapped CPU writes made after invalidate returns. Keep 0 for synchronous read-back.
# nx2_read_nowait = 0
# Extra lines in the log, comma separated: svc, host, ipc, fs, gfx, perf, sched, audio, present or all. The menu's
# Performance log sets perf (frame timings). Default: none.
# trace = perf
# Flight recorder: keeps the last frames and saves them to a flight folder next to the folder of totk.exe when a frame
# takes longer than flight_spike_ms (0 to 60000).
# flight = 0
# flight_spike_ms = 100
# Largest render target (bytes, 0 to 1073741824) that goes back to its game memory when the game waits for a GPU fence.
# A game that reads a larger target without invalidating it sees stale bytes at the default. With trace = gfx the log
# names each dirty target over the limit that stays on the GPU ("fence write-back skipped-for-size") and each one over
# 65536 bytes that went back ("over-default"). Raising it costs a copy per such target and wait.
# wb_fence_limit = 65536
